# Backend
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Anonymous session SQLite path (default: backend/data/app.db)
# SQLITE_PATH=

# Frontend (Vite — copy values into frontend/.env for local dev if needed)
VITE_API_BASE_URL=http://127.0.0.1:8000
